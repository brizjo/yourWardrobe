<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.fragments.GarmentFragment">

    <RelativeLayout
        android:id="@+id/garment_container"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/edit_buttons_container"
            android:padding="@dimen/md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/garmentImage"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/xl"
                    android:scaleType="centerInside" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- ✅ nome capo: font popstar, più grande -->
                    <TextView
                        android:id="@+id/nameGarmentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/popstar"
                        android:textSize="26sp"
                        android:textColor="@color/md_theme_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nameGarmentInputLayout"
                        style="?attr/textInputOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/name"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nameGarmentEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text|textCapSentences"
                            android:fontFamily="@font/popstar"
                            android:imeOptions="actionDone" />

                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/sm"
                    android:layout_marginTop="@dimen/xs"
                    android:background="@color/md_theme_primary" />

                <!-- ✅ titoli sezioni: font popstar, colore nero -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="@dimen/md"
                    android:fontFamily="@font/popstar"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:text="@string/subcategory" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_garment_subcategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="@dimen/md" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="@dimen/md"
                    android:fontFamily="@font/popstar"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:text="@string/season" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_garment_season"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="@dimen/md" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="@dimen/md"
                    android:fontFamily="@font/popstar"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:text="@string/color" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_garment_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="@dimen/md" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="@dimen/md"
                    android:fontFamily="@font/popstar"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:text="@string/style" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_garment_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="@dimen/md" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="@dimen/md"
                    android:fontFamily="@font/popstar"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:text="@string/tessuto" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_garment_fabric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="@dimen/md"
                    android:layout_marginBottom="@dimen/xl" />

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/edit_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:weightSum="2">

            <!-- ✅ font popstar sui bottoni -->
            <Button
                android:id="@+id/update_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/sm"
                android:layout_weight="1"
                android:fontFamily="@font/popstar"
                android:text="@string/applica_modifiche" />

            <Button
                android:id="@+id/cancel_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sm"
                android:layout_weight="1"
                android:fontFamily="@font/popstar"
                android:text="@string/annulla"
                android:textColor="@color/md_theme_error" />
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/edit_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/xl"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/modifica"
            app:srcCompat="@drawable/ic_edit"
            app:backgroundTint="@color/md_theme_primary"
            app:tint="@color/md_theme_onPrimary"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/delete_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/xl"
            android:contentDescription="@string/modifica"
            app:srcCompat="@drawable/ic_delete"
            app:backgroundTint="@color/md_theme_errorContainer_mediumContrast" />

    </LinearLayout>
</FrameLayout>