<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_garment"
        android:layout_width="110dp"
        android:layout_height="110dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:strokeColor="@color/md_theme_primary">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- L'immagine del capo -->
            <ImageView
                android:id="@+id/iv_garment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

            <!-- Overlay semitrasparente quando selezionato -->
            <View
                android:id="@+id/overlay_selected"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#4D000000"
                android:visibility="gone"/>

            <!-- Icona check al centro -->
            <ImageView
                android:id="@+id/iv_check"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_save"                android:visibility="gone"/>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>