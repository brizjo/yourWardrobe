<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".ui.main.fragments.AddGarmentFragment">

    <ImageView
        android:id="@+id/addGarmentImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:scaleType="centerInside"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/caratteristiche_principali"
        android:textAppearance="@style/TextAppearance.YourWardrobe.Body"
        android:textColor="@color/md_theme_primary"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/sm"
        android:layout_marginEnd="@dimen/sm"
        android:background="@color/md_theme_primary" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:text="@string/season"
        android:visibility="gone"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menu_seasons"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/md"
        android:layout_marginTop="@dimen/sm"
        android:layout_marginEnd="@dimen/md">

        <AutoCompleteTextView
            android:id="@+id/auto_complete_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:text="@string/winter"
            />

    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/md"
        android:layout_marginTop="@dimen/md"
        android:text="@string/color"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/md"
        android:layout_marginEnd="@dimen/md"
        app:singleSelection="true"> <!-- Permette di selezionare solo una chip alla volta -->

        <!-- Definisci le singole chip qui -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_red"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/red" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_blue"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="blu" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_green"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="verde" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_black"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="nero" />

    </com.google.android.material.chip.ChipGroup>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"

        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26dp">
    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:text="@string/aggiungi_capo"
        android:enabled="false"/>
    </RelativeLayout>
</LinearLayout>