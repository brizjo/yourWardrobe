<!-- res/layout/dialog_select_garment.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"
    android:background="@color/md_theme_surface">

    <TextView android:id="@+id/dialog_title" style="@style/TextAppearance.YourWardrobe.Title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Seleziona Capi" android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_select_garments"
        android:layout_width="match_parent" android:layout_height="400dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager" app:spanCount="3" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btn_confirm_selection"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Conferma" />
</LinearLayout>