<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.fragments.GarmentFragment">

    <!-- Area scorrevole per il contenuto (Immagine e Caratteristiche) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/edit_buttons_container"
        android:padding="@dimen/md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/garmentImage"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:layout_margin="@dimen/xl"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/nameGarmentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.YourWardrobe.Body"
                android:textColor="@color/md_theme_primary" />


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/sm"
                android:layout_marginTop="@dimen/xs"
                android:background="@color/md_theme_primary" />

            <!-- Aggiungi qui eventuali altre TextView per colore, tessuto, etc. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="@dimen/md"
                android:text="@string/color"
                android:textAppearance="@style/TextAppearance.YourWardrobe.Body" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_garment_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginEnd="@dimen/md">
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="@dimen/md"
                android:text="@string/style"
                android:textAppearance="@style/TextAppearance.YourWardrobe.Body" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_garment_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginEnd="@dimen/md">

            </com.google.android.material.chip.ChipGroup>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="@dimen/md"
                android:text="@string/tessuto"
                android:textAppearance="@style/TextAppearance.YourWardrobe.Body" />


            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_garment_fabric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginEnd="@dimen/md">

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </ScrollView>

    <!-- Contenitore fissato in basso per i bottoni -->
    <LinearLayout
        android:id="@+id/edit_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="@dimen/lg"
        android:gravity="center"
        android:visibility="gone"
        android:weightSum="2">

        <Button
            android:id="@+id/update_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/sm"
            android:layout_weight="1"
            android:text="@string/applica_modifiche" />

        <Button
            android:id="@+id/delete_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sm"
            android:layout_weight="1"
            android:text="@string/elimina_capo"
            android:textColor="@color/md_theme_error" />

    </LinearLayout>

</RelativeLayout>