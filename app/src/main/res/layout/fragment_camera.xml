<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. Anteprima della fotocamera (CameraX) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Overlay per l'effetto scansione (Invisibile di default) -->
    <!-- Questa ImageView "congelerà" il frame scattato per l'animazione -->
    <ImageView
        android:id="@+id/img_freeze_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 3. La linea di scansione (Animata via codice) -->
    <View
        android:id="@+id/scan_line"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/md_theme_primary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4. Controlli (Bottone Scatta) -->
    <!-- 4. Controlli (Bottone Scatta) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_capture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"

        app:fabCustomSize="86dp"
        app:maxImageSize="56dp"

        app:srcCompat="@drawable/ic_tshirt_camera"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:backgroundTint="@android:color/white"
        app:tint="@color/md_theme_primary" />

    <!-- 5. Overlay di caricamento/elaborazione AI -->
    <LinearLayout
        android:id="@+id/processing_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scontornamento AI..."
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>