<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_garment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.main.fragments.AddGarmentFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/addGarmentImage"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="@dimen/lg"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:scaleType="centerInside" />

            <!-- ✅ font troglo, più grande, centrato -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginEnd="@dimen/md"
                android:gravity="center"
                android:fontFamily="@font/troglo"
                android:text="@string/caratteristiche_principali"
                android:textColor="@color/md_theme_primary"
                android:textSize="26sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/sm"
                android:layout_marginEnd="@dimen/sm"
                android:background="@color/md_theme_primary" />

            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="@dimen/lg"
                android:layout_marginEnd="@dimen/md"
                android:hint="@string/name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/garmentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text|textCapSentences" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CATEGORIA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/md"
                android:fontFamily="@font/popstar"
                android:text="@string/Category"
                android:textSize="18sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/menu_category"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/Category"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="@dimen/xs"
                android:layout_marginEnd="@dimen/md">

                <AutoCompleteTextView
                    android:id="@+id/category_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- SOTTOCATEGORIA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/md"
                android:fontFamily="@font/popstar"
                android:text="@string/subcategory"
                android:textSize="18sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_subcategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/md"
                android:layout_marginBottom="8dp" />

            <!-- STAGIONE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/md"
                android:fontFamily="@font/popstar"
                android:text="@string/season"
                android:textSize="18sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_season"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/md"
                android:layout_marginBottom="8dp" />

            <!-- COLORE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/md"
                android:fontFamily="@font/popstar"
                android:text="@string/color"
                android:textSize="18sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/md"
                android:layout_marginBottom="8dp" />

            <!-- STILE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/md"
                android:fontFamily="@font/popstar"
                android:text="@string/style"
                android:textSize="18sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/md"
                android:layout_marginBottom="8dp" />

            <!-- TESSUTO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/md"
                android:fontFamily="@font/popstar"
                android:text="@string/tessuto"
                android:textSize="18sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_fabric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/md"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26dp">

        <ProgressBar
            android:id="@+id/add_garment_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_garment_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:enabled="false"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:fontFamily="@font/popstar"
            app:cornerRadius="@dimen/lg"
            android:text="@string/add_garment" />

    </RelativeLayout>

</LinearLayout>