<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.fragments.ClothesFragment">

    <ProgressBar
        android:id="@+id/loading_progressbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <RelativeLayout
            android:id="@+id/top_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp">

            <!-- Filtro e Ordina sulla sinistra -->
            <LinearLayout
                android:id="@+id/left_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/filter_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/filter_garments"
                    android:focusable="true"
                    android:padding="@dimen/xs"
                    android:src="@drawable/ic_filter"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/order_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Ordina"
                    android:focusable="true"
                    android:padding="@dimen/xs"
                    android:src="@drawable/ic_order"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Solo bottone Importa sulla destra -->
            <LinearLayout
                android:id="@+id/right_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/import_from_gallery_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/popstar"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:text="Importa"
                    android:textSize="13sp"
                    app:cornerRadius="@dimen/lg"
                    app:icon="@drawable/ic_image"
                    app:iconGravity="start"
                    app:iconPadding="4dp"
                    app:iconSize="20dp"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </RelativeLayout>

        <HorizontalScrollView
            android:id="@+id/active_filters_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/active_filters_chipgroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:singleLine="true" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/categories_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <!-- Parte Superiore -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sm"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/troglo"
                        android:text="@string/parte_superiore"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="24sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/sm"
                        android:layout_marginEnd="@dimen/sm"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/md_theme_primary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/parte_superiore_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

                    <!-- Parte Inferiore -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sm"
                        android:layout_marginTop="28dp"
                        android:fontFamily="@font/troglo"
                        android:text="@string/parte_inferiore"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="24sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/sm"
                        android:layout_marginEnd="@dimen/sm"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/md_theme_primary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/parte_inferiore_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

                    <!-- Calzature -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sm"
                        android:layout_marginTop="28dp"
                        android:fontFamily="@font/troglo"
                        android:text="@string/footwear"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="24sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/sm"
                        android:layout_marginEnd="@dimen/sm"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/md_theme_primary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/calzature_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

                    <!-- Accessori -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sm"
                        android:layout_marginTop="28dp"
                        android:fontFamily="@font/troglo"
                        android:text="@string/accessori"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="24sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/sm"
                        android:layout_marginEnd="@dimen/sm"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/md_theme_primary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/accessori_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="32dp" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/item_clothes_grid" />

            <!-- FAB Aggiungi -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/add_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="Aggiungi capo"
                android:src="@drawable/ic_add"
                app:backgroundTint="?attr/colorPrimary"
                app:tint="?attr/colorOnPrimary" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/empty_wardrobe_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@string/armadio_vuoto"
                android:src="@drawable/ic_hanger"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/popstar"
                android:text="@string/empty_wardrobe_message"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <Button
                android:id="@+id/add_first_garment_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/popstar"
                android:text="@string/add_garment"
                app:cornerRadius="@dimen/lg"
                app:icon="@drawable/ic_add" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>